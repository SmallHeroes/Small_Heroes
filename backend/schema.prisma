// Prisma Schema — גיבורים קטנים
// Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────
enum OrderStatus {
  draft
  pending_payment
  paid
  generating
  ready
  failed
  partial // story+images ready but audio failed
  needs_human_qa // book rendered but held from customer delivery pending human QA (e.g. low-confidence anchor)
}

enum GenerationStatus {
  pending
  running
  done
  failed
}

enum StoryDirectionArchetype {
  bedtime
  adventure
  fantasy
}

enum StoryDirectionSetStatus {
  pending
  ready
  selected
  failed
}

enum StoryLength {
  short   // 10 pages (bedtime tier)
  medium  // 15 pages (adventure tier)
  long    // 20 pages (fantasy tier)
}

enum IllustrationStyle {
  pencil_watercolor
  realistic_illustrated
  whimsical_comic_fantasy
  detailed_whimsical_world
  // Legacy — kept to avoid DB migration failures on old rows
  clean_cartoon_2d
  soft_3d_animation
  illustrative_classic
  realistic_cartoon
}

// Phase-1 base_book_integrity — readiness/fulfillment lifecycles (flag READINESS_MANIFEST_ENABLED, default OFF).
enum ReadinessStatus {
  pending
  passed
  blocked
  stale
}

enum DeliveryOutboxStatus {
  scheduled
  processing
  sent
  failed
  suppressed             // legacy (pre-P1-f live-recheck path); no longer produced
  superseded             // legacy (P1-f #3, pre-split); no longer produced
  // (P1-f #3h-D) Recovery taxonomy. A CAS mismatch is NEVER a business revocation — it is a recoverable
  // not-yet-deliverable state. The worker (CAS) may only ever write the two RECOVERABLE terminals below.
  delivery_blocked       // CAS mismatch: order not ready (paid/generating/needs_human_qa/partial are all TRANSIENT),
  //                        readiness not passed, or inputs_stale. RECOVERABLE → a re-commit rebinds this row,
  //                        but ONLY while sendAttempted=false (a post-send blocked row needs reconciliation).
  superseded_by_manifest // defense-in-depth / protocol-drift: a newer VALID manifest owns the order (ready+passed,
  //                        different manifestId). RECOVERABLE via the re-commit rebind. Not a normal-flow path.
  invalid_payload        // payload-integrity recompute mismatch (corrupt/tampered row). NOT a business revocation;
  //                        needs investigation → reconciliation, never auto-revived.
  delivery_revoked       // RESERVED for an explicit domain action (cancellation/refund). The CAS NEVER writes this;
  //                        no writer exists yet. NOT auto-recoverable → explicit reconciliation/redelivery.
}

enum ExceptionCaseKind {
  infra_transient
  unusable_photo
  text_personalization
  safety_failed
  quality_failed
  send_ambiguous
  delivery_revoked
  invalid_payload
  integrity_blocked
}

enum ExceptionCaseStatus {
  open
  retry_scheduled
  customer_action
  refund_pending
  resolved
  cancelled
}

// ─── Customer ─────────────────────────────────────────
model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ─── WizardSession ────────────────────────────────────
// Stores raw wizard input before order creation
model WizardSession {
  id        String   @id @default(cuid())
  sessionId String   @unique  // browser session ID
  data      Json                // full wizard state blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order?
}

// ─── Order ────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(draft)

  // Customer
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  userId          String?
  user            UserAccount? @relation(fields: [userId], references: [id])
  customerEmail   String
  customerName    String

  // Child / story config
  childName         String
  childAge          Int?
  childGender       String?
  childTraits       String[]
  childSuperpower   String?   // single hero trait selected in wizard
  bookName          String?   // optional custom book title from wizard
  dedication        String?   @db.VarChar(300)
  childImageUrl     String?
  characterAnchors  Json?
  familyContext     Json?     // { parent1, parent2, sibling, homeText } — optional, from wizard step 4

  // Story parameters
  topic           String
  challengeItems  String[]
  challengeFree   String?
  outcomeItems    String[]
  outcomeFree     String?
  helperItems     String[]
  helperFree      String?
  avoidItems      String[]
  avoidFree       String?

  // Product configuration
  storyLength        StoryLength       @default(medium)
  /** Wizard package tier: bedtime | adventure | fantasy (matches pricing + page count). */
  storyDirection     String?
  coverImageUrl      String?
  illustrationStyle  IllustrationStyle @default(pencil_watercolor)
  audioEnabled       Boolean           @default(false)
  selectedVoice      String?
  sleepMode          Boolean           @default(false)
  pdfEnabled         Boolean           @default(false)
  bundleEnabled      Boolean           @default(false)
  videoEnabled       Boolean           @default(false)

  // Pricing
  basePrice          Int   // in agorot (ILS cents)
  addonsPrice        Int
  totalPrice         Int   // in agorot; reflects the coupon discount once one is applied

  // Coupon / launch discount (nullable — most orders carry none). basePrice+addonsPrice keep
  // the PRE-discount components for the receipt; totalPrice is the discounted amount charged.
  // These snapshot which code was applied and how much it took off (audit / summary display).
  couponCode            String?
  couponDiscountPercent Int?
  couponDiscountAgorot  Int?

  // (LB#1b) CHECKOUT-ATTEMPT LEASE — the atomic owner of an in-flight checkout for THIS order.
  // Claimed by a CAS (updateMany) BEFORE the coupon reservation and BEFORE the PayMe sale is created,
  // so two concurrent /api/checkout on one order can never both reserve a slot and charge: the loser is
  // rejected. TTL-bounded (checkoutAttemptAt + CHECKOUT_ATTEMPT_TTL_MS), so an abandoned/crashed attempt
  // frees the order for a legitimate retry instead of wedging it forever.
  checkoutAttemptToken  String?
  checkoutAttemptAt     DateTime?

  // Stripe
  stripeSessionId    String?  @unique
  stripePaymentId    String?
  stripePaid         Boolean  @default(false)
  stripeMetadata     Json?

  // Generic payment tracking (PayMe-first)
  paymentProvider    String?
  paymentId          String?
  paymeTransactionId String?  @unique
  paymeMetadata      Json?

  // Generation tracking
  textStatus         GenerationStatus @default(pending)
  imageStatus        GenerationStatus @default(pending)
  audioStatus        GenerationStatus @default(pending)
  packageStatus      GenerationStatus @default(pending)

  // Delivery hold: when status == needs_human_qa, why it was held (e.g.
  // "anchor_low_confidence:soft_band"). Cleared/ignored once QA releases to ready.
  deliveryHoldReason String?

  // Phase-1 base_book_integrity — FROZEN product-truth. Set once at order-creation + text-finalization;
  // the integrity gate reads ONLY these (never a live resolver in the package stage). An existing value
  // that differs from a fresh computation => fail loudly (a deploy changed the story under a live order).
  expectedPageCount    Int?
  storySourceHash      String?
  selectionFilename    String?
  frozenProductVersion String?
  fulfillmentVersion   Int      @default(1)  // logical delivery-event version; part of the Outbox dedupe key
  // Monotonic optimistic-concurrency token (P1-f #5). Every writer of delivery inputs
  // (text/frozen/assets/payload fields) advances it through withDeliveryInputMutation in the same transaction.
  // The readiness manifest records the evaluated value; Order→ready and the send-time CAS require it unchanged.
  inputVersion         Int      @default(0)

  // (delivery fence — Codex round-4 P0) Monotonic SHARED delivery-authority token, orthogonal to inputVersion.
  // EVERY hold write (safety/contract_world park, payment fence, readiness hard-hold) atomically increments it
  // in the SAME write as the hold. The readiness commit reads it and binds the `ready` transition + Outbox enqueue
  // to the observed value, so a hold landing at ANY point during a commit aborts the ship (0-row CAS) instead of
  // clobbering the hold. Kept separate from inputVersion, which already drives readiness invalidation, receipt
  // identity and the TOCTOU retry — bumping THAT on every park would fire all three side effects; this does not.
  deliveryFenceVersion Int      @default(0)

  // WS0 BookVisualContract vNext (enforcement OFF). Additive. The contract is frozen before any paid image
  // (step 4) and its canonical hash is stamped here; QualityEvidence.contractHash is validated against it so a
  // row produced under a superseded contract is treated as stale. `manualReviewRequired` backs the FALLBACK
  // manual-review path (Decision Gate clarification 1: auto-repair/regeneration is the primary path).
  visualContractHash   String?
  manualReviewRequired Boolean  @default(false)

  // Error tracking
  lastError          String?
  errorAt            DateTime?

  // Relations
  wizardSessionId    String?      @unique
  wizardSession      WizardSession? @relation(fields: [wizardSessionId], references: [id])
  book               GeneratedBook?
  payment            PaymentRecord?
  couponRedemption   CouponRedemption?
  generationJob      GenerationJob?
  storyDirectionSet  StoryDirectionSet?
  resemblanceAudits  ResemblanceAudit[]
  exceptionCases     ExceptionCase[]
  qualityEvidence    QualityEvidence[]
  atomicOperationReceipts AtomicOperationReceipt[]
  humanQaReviewCases HumanQaReviewCase[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UserAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?

  orders    Order[]
  sessions  UserSession[]
  otpCodes  OtpCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ResemblanceAudit {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pageNumber            Int?
  candidateIndex        Int?
  selected              Boolean  @default(false)
  seed                  Int?
  model                 String?
  styleId               String?
  resemblanceScore      Float?
  allCandidateScores    Float[]
  threshold             Float?
  minAcceptableScore    Float?
  softFailBand          Float?
  extremeMargin         Float?
  selectionGap          Float?
  resemblanceStatus     String?
  resemblanceConfidence String?
  inputStrength         String?
  sanityDisagreement    Boolean?
  lowDiversity          Boolean?
  extremeMismatch       Boolean?
  reason                String?
  reasonCodes           String[]
  faceDetectConfidence  Float?
  faceAreaRatio         Float?
  brightness            Float?
  sharpness             Float?
  source                String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([orderId, createdAt])
}

model StoryDirectionSet {
  id                  String                  @id @default(cuid())
  orderId             String                  @unique
  order               Order                   @relation(fields: [orderId], references: [id])
  selectedStyle       IllustrationStyle
  status              StoryDirectionSetStatus @default(pending)
  selectedDirectionId String?                 @unique
  selectedDirection   StoryDirection?         @relation("SelectedStoryDirection", fields: [selectedDirectionId], references: [id], onDelete: SetNull)
  directions          StoryDirection[]        @relation("StoryDirectionSetDirections")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model StoryDirection {
  id                 String                 @id @default(cuid())
  directionSetId     String
  directionSet       StoryDirectionSet      @relation("StoryDirectionSetDirections", fields: [directionSetId], references: [id], onDelete: Cascade)
  archetype          StoryDirectionArchetype
  title              String
  summary            String                 @db.Text
  emotionalLabel     String
  storyPremise       String                 @db.Text
  openingScenePrompt String                 @db.Text
  previewImagePrompt String                 @db.Text
  previewImageUrl    String?
  previewImageRawUrl String?

  selectedBySet      StoryDirectionSet?     @relation("SelectedStoryDirection")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([directionSetId, archetype])
}

// ─── GeneratedBook ────────────────────────────────────
model GeneratedBook {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  title       String
  coverText   String?
  coverImageUrl String?
  /// (Stage 1 safety FIX) The cover's readiness-independent physical-safety signal (the cover is not an ImageAsset).
  /// Written atomically with coverImageUrl; the delivery boundary blocks unless verified AND hazard-free.
  coverSafetyVerified Boolean  @default(false)
  coverSafetyHazards  String[] @default([])
  pages       BookPage[]

  audioAsset  AudioAsset?
  pdfUrl      String?
  videoUrl    String?   // on-demand exported MP4 (full book slideshow + narration)

  readUrl     String?   // public read link
  expiresAt   DateTime? // if links expire

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── BookPage ─────────────────────────────────────────
model BookPage {
  id          String        @id @default(cuid())
  bookId      String
  book        GeneratedBook @relation(fields: [bookId], references: [id])

  pageNumber  Int
  text        String        @db.Text
  pageTemplate String?
  textZone    String?
  lighting    String?
  textColorScheme String?
  imageAsset  ImageAsset?

  // narration text (may differ from display text — sleep mode pacing etc)
  narrationText String?     @db.Text

  /// Per-page narration MP3 (ElevenLabs). Legacy books use AudioAsset on GeneratedBook only.
  audioUrl    String?

  createdAt   DateTime @default(now())
}

// ─── ImageAsset ───────────────────────────────────────
model ImageAsset {
  id          String    @id @default(cuid())
  pageId      String    @unique
  page        BookPage  @relation(fields: [pageId], references: [id])

  provider    String    // "dall-e-3" | "replicate" | "stability"
  prompt      String    @db.Text
  url         String    // stored URL (after saving to our storage)
  /// Reader/PDF-ready asset: edge-softened, paper-integrated treatment of `url` (null = use `url`)
  presentationUrl String?
  rawUrl      String?   // original provider URL
  width       Int?
  height      Int?
  style       String?
  /// orderId + artifactType + page + model + quality + generationVersion — skip duplicate paid gen
  idempotencyKey String? @unique

  /// (Stage 1 safety FIX) Readiness-INDEPENDENT physical-safety signal, written ATOMICALLY with the asset so a
  /// crash can't lose a known hazard and the delivery boundary enforces it even when the readiness manifest is OFF.
  /// safetyVerified=false (default) means the safety check has NOT confirmed this image safe → fail-closed (blocked).
  safetyVerified Boolean  @default(false)
  /// The confirmed physical-safety hazards on this image (empty when safe). Deliver only when verified AND empty.
  safetyHazards  String[] @default([])

  createdAt   DateTime @default(now())
}

// ─── AudioAsset ───────────────────────────────────────
model AudioAsset {
  id          String        @id @default(cuid())
  bookId      String        @unique
  book        GeneratedBook @relation(fields: [bookId], references: [id])

  provider    String        // "elevenlabs"
  voiceId     String
  voiceLabel  String?
  sleepMode   Boolean       @default(false)
  url         String        // stored audio URL
  durationSec Float?

  createdAt   DateTime @default(now())
}

// ─── PaymentRecord ────────────────────────────────────
model PaymentRecord {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])

  provider        String   @default("stripe")
  stripeSessionId String?
  stripeEventId   String?
  amount          Int      // in agorot
  currency        String   @default("ils")
  paid            Boolean  @default(false)
  paidAt          DateTime?
  raw             Json?    // full stripe event payload

  createdAt       DateTime @default(now())
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  stripeEventId String @unique
  eventType   String
  orderId     String?
  processedAt DateTime @default(now())
}

model PaymeWebhookEvent {
  id                 String   @id @default(cuid())
  paymeTransactionId String   @unique
  eventType          String
  orderId            String?
  processedAt        DateTime @default(now())
}

// ─── GenerationJob ────────────────────────────────────
model GenerationJob {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  status      GenerationStatus @default(pending)
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  attempts    Int      @default(0)
  lastError   String?

  // Stage tracking
  textDone    Boolean @default(false)
  imagesDone  Boolean @default(false)
  audioDone   Boolean @default(false)
  packaged    Boolean @default(false)

  /// Chunked pipeline: text | dna | cover | page_images | audio | video | package | done | failed
  currentStage       String   @default("pending")
  lockedBy           String?
  leaseExpiresAt     DateTime?
  generationVersion  Int      @default(1)
  provider           String?
  model              String?
  quality            String?
  triggerReason      String?
  retryable          Boolean  @default(false)

  // Reliability / recovery diagnostics (additive). The HTTP self-chain is best-effort;
  // durable recovery is the sweeper reclaiming expired leases. These make a silent chain
  // failure DB-visible and bound infinite re-spend on a stuck stage.
  staleReclaimCount  Int      @default(0)  // times the sweeper has reclaimed this job
  lastReclaimStage   String?              // progress fingerprint at last reclaim (stage:completedCount)
  lastChainStatus    Int?                 // HTTP status of the last self-chain kick (e.g. 401)
  lastChainError     String?              // last self-chain failure (host/status/body snippet)
  lastWorkerKickAt   DateTime?            // when the last self-chain kick was attempted
  /// Cached DNA / story paths between chunks (JSON)
  pipelineCache      Json?
  completedPageNumbers Json?
  failedPageNumbers    Json?
  pageAttempts         Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([currentStage])
}

// ─── Phase-1 base_book_integrity ──────────────────────
// IMMUTABLE per-evaluation record: one terminal INSERT with passed|blocked. evidence + status are NEVER
// mutated. The "current" readiness for an (order, scope) is the latest revision whose inputsHash still
// matches the current assets; an older passed Manifest stays passed but is no longer current (=> stale).
model BookReadinessManifest {
  id         String          @id @default(cuid())
  orderId    String
  scope      String          // e.g. "base_book"
  revision   Int             // atomically allocated; (orderId, scope, revision) is unique
  status     ReadinessStatus // only `passed` or `blocked` are ever written here
  inputsHash String          // hash of the inputs (assets + frozen text) this evaluation observed
  inputVersion Int           @default(0) // Order.inputVersion observed at evaluation time (P1-e2 B4 optimistic-concurrency)
  evidence   Json            // per-check evidence (decode/bytes/mime/sha per asset, page list, frozen truth…)
  reason     String?         // block reason (null when passed)
  createdAt  DateTime        @default(now())

  @@unique([orderId, scope, revision])
  @@index([orderId, scope])
}

// MUTABLE pointer to the current readiness state per (order, scope).
model BookReadiness {
  id                String          @id @default(cuid())
  orderId           String
  scope             String
  status            ReadinessStatus @default(pending)
  currentManifestId String?
  reason            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([orderId, scope])
}

// Transactional outbox for customer deliveries (effectively-once). enqueue != send; a worker/cron drains
// it with an atomic lease and idempotent provider send. dedupeKey = a logical fulfillment event.
model DeliveryOutbox {
  id                String               @id @default(cuid())
  dedupeKey         String               @unique // book-ready/{orderId}/base-book/{fulfillmentVersion}
  orderId           String
  scope             String
  status            DeliveryOutboxStatus @default(scheduled)
  payload           Json
  payloadHash       String               // same dedupeKey + a different payloadHash => error, never send
  // (P1-f) Unambiguous binding of this delivery to the manifest + inputVersion it was enqueued under. The
  // send-time CAS verifies BookReadiness.currentManifestId === manifestId AND Order.inputVersion === inputVersion.
  // A re-commit REBINDS this row to the new manifest in place (same dedupeKey); enqueueDelivery ALWAYS sets both
  // on create and on rebind, so they are NOT NULL (#3h #6 — preflight: the table is empty everywhere).
  manifestId        String
  inputVersion      Int
  // (delivery fence — Codex round-5 P1) The shared Order.deliveryFenceVersion this delivery was enqueued under.
  // The send-time CAS re-verifies Order.deliveryFenceVersion === this, making the Outbox->fence link EXPLICIT rather
  // than incidental (it was previously only guaranteed by enqueue + ready flip committing in the same tx).
  deliveryFenceVersion Int               @default(0)
  // Monotonic claim/rebind version used only for lease fencing. It is deliberately NOT a send-retry counter.
  attempts          Int                  @default(0)
  // Number of possible provider sends. Incremented by the send-time CAS immediately before each provider call.
  sendAttempts      Int                  @default(0)
  nextAttemptAt     DateTime?
  leaseExpiresAt    DateTime?
  lastError         String?
  // Durable failure classification. With the P1-f pure-CAS path the ONLY value produced is send_ambiguous:
  //   a provider send was attempted and the result is unknown (Resend may have accepted) -> NEVER auto-roll
  //   (a new fulfillment = new idempotency key = bypasses the 24h dedup). The roll decision keys off
  //   sendAttempted, not this column. recheck_exhausted is LEGACY (the removed live-recheck path), no longer written.
  failureClass      String?
  // Durable "a provider send was EVER attempted on this row" (P1-e4 review C + P1-f). The single source of
  // truth for the rebind/reconciliation decision: a row is rebindable ONLY while sendAttempted is false.
  sendAttempted     Boolean              @default(false)
  // (P1-f #3h) Timestamp of the FIRST send attempt (set once, by the CAS, via COALESCE). Resend's 24h
  // idempotency window is measured from HERE, not createdAt: an order that sat 25h in the queue still gets its
  // first attempt; a re-attempt > 24h after the first becomes send_ambiguous (no blind resend).
  firstSendAttemptAt DateTime?
  providerMessageId String?
  createdAt         DateTime             @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
}

// Autonomous fail-closed recovery. `activeKey` is `${orderId}:${scope}` while the case is active and NULL
// after a terminal transition. The migration adds a CHECK that binds this invariant to status, so the unique
// key enforces exactly one active case per order/scope even under concurrent producers.
model ExceptionCase {
  id                  String              @id @default(cuid())
  activeKey           String?             @unique
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scope               String
  kind                ExceptionCaseKind
  status              ExceptionCaseStatus @default(open)
  reason              String
  attempts            Int                 @default(0)
  nextActionAt        DateTime?
  resolution          Json?
  sourceRef           String?
  claimVersion        Int                 @default(0)
  leaseExpiresAt      DateTime?
  lastError           String?
  refundKey           String?             @unique
  providerActionId    String?
  actionAttemptedAt   DateTime?
  notificationAttemptedAt DateTime?
  notificationMessageId String?
  audits              ExceptionCaseAudit[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, nextActionAt])
  @@index([orderId, scope])
}

model ExceptionCaseAudit {
  id          String               @id @default(cuid())
  eventKey    String               @unique
  caseId      String
  case        ExceptionCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus  ExceptionCaseStatus?
  toStatus    ExceptionCaseStatus
  actor       String               @default("system")
  reason      String
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([caseId, createdAt])
}

// (#6-FIX-2) Durable, order:scope-level reissue budget. A per-CASE bound doesn't compose — each reissue spawns a
// new case + fulfillmentVersion + clock, so it could reissue indefinitely. This row survives across cases and
// fulfillmentVersions: `count` caps total reissues; `windowStartAt` is the FIRST send attempt of the original
// delivery (the GLOBAL 48h window anchor, not a per-case clock).
model ReissueBudget {
  id            String   @id @default(cuid())
  orderId       String
  scope         String
  count         Int      @default(0)
  windowStartAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orderId, scope])
}

// (#6-FIX-3) Durable exactly-once fence for provider refunds (PayMe). `actionAttemptedAt` on the case is only a
// reservation marker; this record is the effect-once fence. It is created (status 'requested') BEFORE refund-sale
// is called, keyed on the stable refundKey, so a response-loss + restart never issues a second provider refund.
model RefundAttempt {
  id               String   @id @default(cuid())
  refundKey        String   @unique
  provider         String
  providerSaleId   String
  status           String // (#6 FIX-5) 'requested' (refund-sale NOT sent) | 'dispatched' (sent) | 'pending' | 'confirmed'
  providerActionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// (#7-a Quality gate fail-closed) Durable per-artifact visual-QA evidence. ONE row per REQUIRED delivered
// artifact (cover + every page). The readiness commit reads these FAIL-CLOSED: a `failed` verdict (after the
// regen budget is spent) BLOCKS delivery + opens a terminal quality_failed case (refund); an `evidence_unknown`
// / missing / stale row BLOCKS + opens an infra_transient recovery case (retry QA vs the SAME asset). No path
// delivers on absent or non-`passed` evidence. `assetSha256` binds the verdict to the EXACT delivered bytes
// (presentationUrl ?? url) so a PASS can never authorize a different image; `evaluatorContractVersion`
// invalidates evidence from an older evaluator. Internal server-side table (RLS enabled, no client policy —
// service-role only, mirrors ExceptionCase/ReissueBudget).
model QualityEvidence {
  id                       String   @id @default(cuid())
  orderId                  String
  order                    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artifactKey              String   // "cover" | "page:<n>"
  assetSha256              String   // SHA-256 of the exact delivered bytes (presentationUrl ?? url)
  verdict                  String   // "passed" | "failed" | "evidence_unknown" (CHECK-constrained in the migration)
  evaluatorContractVersion String
  reason                   String?
  regenCount               Int      @default(0)
  providerModel            String?
  evidence                 Json?
  evaluatedAt              DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // WS0 BookVisualContract vNext (enforcement OFF). Additive. A row is admissible only while contractHash
  // matches the Order's active visualContractHash (a mismatch → stale → re-QA). The reviewed* fields back the
  // FALLBACK manual-review path (a decision recorded against the exact asset SHA + contract hash); the endpoint
  // that writes them is wired in a later slice — WS0 only lays the columns.
  contractHash             String?
  reviewStatus             String?
  reviewedAssetSha256      String?
  reviewedContractHash     String?
  reviewedBy               String?
  reviewedAt               DateTime?
  reviewReason             String?

  @@unique([orderId, artifactKey])
  @@index([orderId])
}

// (pooler-fix / Codex B′) Durable idempotency receipt for the generation worker's post-render interactive
// transactions. Under the Supavisor TRANSACTION pooler (6543) a barrier tx can commit yet the caller still
// receives P2028 ("Transaction not found") after the long render gap. The receipt is written in the SAME tx as
// the business mutation, keyed by a durable operationKey — so a retry re-enters through the fence: if the prior
// attempt committed, the unique operationKey conflicts and the RECORDED result is returned (exactly-once, the
// mutation is NEVER reapplied); if it did not commit, the receipt is absent and the mutation runs. A payloadHash
// mismatch under the same key fails closed (same key + different payload = a defect). Service-role only (RLS
// enabled, no client policy — mirrors ExceptionCase/QualityEvidence).
model AtomicOperationReceipt {
  id           String   @id @default(cuid())
  operationKey String   @unique // durable, survives worker retries; the exactly-once fence key
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         String   // which barrier: 'delivery_input' | 'regen_reserve' | 'readiness_commit'
  payloadHash  String   // hash of the operation's inputs; a mismatch under the same key fails closed
  result       Json     // the recorded return value (inputVersion, revision, granted, orderStatus, …) replayed on a fence hit
  createdAt    DateTime @default(now())

  @@index([orderId])
}

// ─── Coupon / launch promo code ───────────────────────
// One shared launch code (e.g. FIRST100) giving an extra % off, hard-capped at
// maxRedemptions. RESERVE-AT-CHECKOUT (lease) model:
//   • A redemption row is RESERVED when the discounted sale is created (holds a
//     slot with a TTL via expiresAt).
//   • It is CONFIRMED inside the exactly-once payment-success transaction.
//   • Expired 'reserved' rows do NOT count toward the cap, so abandoned carts
//     never burn a slot; a stale hold self-frees.
// confirmedCount is monotonic and only advances on payment success. The cap
// invariant, enforced under a Coupon-row FOR UPDATE lock at reserve time, is:
//   confirmedCount + (# reserved & not expired) <= maxRedemptions
// so confirmedCount can never exceed maxRedemptions even under concurrency.
enum CouponRedemptionStatus {
  reserved
  confirmed
  released
}

// ─── Human-QA hold lifecycle (Slice 1, Unit 1) ────────
// Additive + inert; no pipeline seam writes these tables yet. Mirrors ExceptionCase/DeliveryOutbox.
enum HumanQaHoldKind {
  safety
  contract_world
  anchor
  payment_integrity
  legacy_unknown
}

enum HumanQaReviewCaseStatus {
  open                   // the ONLY active status
  superseded             // terminal
  resolved               // terminal
  cancelled              // terminal
}

enum OperatorNotificationOutboxStatus {
  scheduled
  processing
  sent
  failed
  suppressed
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int      // whole percent off, e.g. 25
  maxRedemptions  Int      // hard cap on confirmed redemptions
  confirmedCount  Int      @default(0) // monotonic; ++ only on payment success
  active          Boolean  @default(false) // off until the owner enables it live
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     CouponRedemption[]
}

model CouponRedemption {
  id              String                 @id @default(cuid())
  couponId        String
  coupon          Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  code            String                 // denormalized coupon code (audit / query convenience)
  orderId         String                 @unique // one redemption per order → idempotent reserve/confirm
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          CouponRedemptionStatus @default(reserved)
  discountPercent Int                    // snapshot at reserve time
  discountAgorot  Int                    // actual discount applied, in agorot (audit)
  // (LB#1b) The checkout ATTEMPT that owns this hold. Release is TOKEN-BOUND: a failed attempt may only
  // release the reservation it created, never a sibling attempt's live hold (which previously let one
  // attempt's failure free another's slot, so the paid order's confirm then no-op'd and went uncounted).
  attemptToken    String?
  reservedAt      DateTime               @default(now())
  expiresAt       DateTime               // reserve + TTL; expired 'reserved' rows are free capacity
  confirmedAt     DateTime?
  releasedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([couponId, status, expiresAt])
}

// (Human-QA Slice 1, Unit 1) Durable, superseding review case for a delivery HOLD. `activeKey` is
// `${orderId}:${scope}` while the case is `open` and NULL after any terminal transition; the migration adds a
// CHECK binding that invariant to `status` (open ⇒ activeKey set; superseded/resolved/cancelled ⇒ NULL), so the
// nullable unique key enforces exactly one active case per order/scope even under concurrent producers.
// The evidence snapshot (holdFingerprint/rawReason/inputVersion/contractHash/sourceManifestId/artifactRefs) is
// IMMUTABLE once written — a supersede opens a NEW revision, it never rewrites the old case's evidence.
model HumanQaReviewCase {
  id                 String                  @id @default(cuid())
  activeKey          String?                 @unique // `${orderId}:${scope}` while open, NULL when terminal
  orderId            String
  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scope              String                  // base_book for safety/contract_world/anchor; payment for payment_integrity
  revision           Int                     // 1-based; increments on supersede
  kind               HumanQaHoldKind
  status             HumanQaReviewCaseStatus @default(open)
  holdFingerprint    String                  // immutable hold identity (see computeHoldFingerprint)
  rawReason          String                  // the deliveryHoldReason marker verbatim
  humanReason        String                  // readable
  sourceManifestId   String?
  inputVersion       Int
  contractHash       String?
  artifactRefs       Json?                   // URLs/SHAs evidence snapshot (immutable)
  heldAt             DateTime                @default(now())
  supersededByCaseId String?
  resolvedActor      String?
  resolvedAt         DateTime?
  decisionNote       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  notifications OperatorNotificationOutbox[]

  @@unique([orderId, scope, revision])
  @@index([status])
  @@index([orderId, scope])
}

// (Human-QA Slice 1, Unit 1) SEPARATE operator-notification outbox — NOT DeliveryOutbox. Mirrors its lease/fencing
// shape: `claimVersion` is the lease-fencing token (mirrors DeliveryOutbox.attempts, NOT a send-retry counter),
// `sendAttempts` is bumped by a send-time CAS immediately before each provider call, `sendAttempted` is the durable
// "a send was EVER attempted" flag (a row is rebindable/suppressible only while it is false). The ONLY failureClass
// value is `send_ambiguous`.
model OperatorNotificationOutbox {
  id                 String                           @id @default(cuid())
  dedupeKey          String                           @unique // human-qa/${orderId}/${scope}/${revision}
  caseId             String
  case               HumanQaReviewCase                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderId            String
  scope              String
  status             OperatorNotificationOutboxStatus @default(scheduled)
  payload            Json
  payloadHash        String
  claimVersion       Int                              @default(0)
  sendAttempts       Int                              @default(0)
  nextAttemptAt      DateTime?
  leaseExpiresAt     DateTime?
  lastError          String?
  failureClass       String?                          // only `send_ambiguous`
  sendAttempted      Boolean                          @default(false)
  firstSendAttemptAt DateTime?
  providerMessageId  String?
  createdAt          DateTime                         @default(now())
  sentAt             DateTime?

  @@index([status, nextAttemptAt])
}
